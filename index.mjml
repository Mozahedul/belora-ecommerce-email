          <span>Discover breathable fabrics, modern</span><br />
          <span>silhouettes and color that feel like</span><br />
          <span>sunshines.</span>
        </mj-text>
        <!-- Hero button — amber accent -->
        <mj-button
          href="https://mjml.io/product"
          font-size="12px"
          font-weight="600"
          letter-spacing="0.12em"
          color="#ffffff"
          background-color="#1a1a1a"
          border-radius="0"
          inner-padding="16px 36px"
          align="left"
          padding-bottom="0px"
        >
          SHOP THE <br />
          COLLECTION &nbsp;→
        </mj-button>
      </mj-column>
      <mj-column vertical-align="middle" padding="0px">
        <mj-image
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1780110726/email-portfolio/belora-ecommerce-email/images/banner-3_bc46x0.jpg"
          alt="banner image"
          align="left"
          padding="0px 0px 0px 15px"
        />
      </mj-column>
    </mj-section>

    <!-- MJ Border -->
