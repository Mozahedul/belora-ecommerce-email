<mjml>
  <mj-head>
    <!-- Email Subject Preview -->
    <mj-preview>
      Limited-time offer on handcrafted ceramic mugs. Shop now before it's gone.
    </mj-preview>

    <!-- Breakpoint -->
    <mj-breakpoint width="480px" />

    <!-- Email Title -->
    <mj-title>Obsidian Ceramic Mug – Special Offer</mj-title>

    <!-- Google Font -->
    <mj-font
      name="Lato"
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap"
    />

    <mj-font
      name="Playfair"
      href="https://fonts.googleapis.com/css2?family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&display=swap"
    />

    <!--
    ================================================
      COLOR SYSTEM
    ================================================

      LIGHT MODE
      ----------
      Email outer bg        → #f4f4f4
      Section bg            → #ffffff
      Card bg               → #f8f8f8
      Border                → #e8e8e8
      Heading               → #111111
      Subheading            → #444444
      Body text             → #666666
      Muted                 → #888888
      Footer text           → #999999

      DARK MODE
      ----------
      Email outer bg        → #111111
      Section bg            → #1a1a1a
      Card bg               → #222222
      Border                → #333333
      Heading               → #f0f0f0
      Subheading            → #cccccc
      Body text             → #aaaaaa
      Muted                 → #888888
      Footer text           → #666666

      ACCENT (both modes)
      -------------------
      Primary green         → #1a5c38
      Amber                 → #c97d2e

      DIVIDERS
      --------
      Light                 → #e8e8e8  (dark: #333333)
      Strong                → #cccccc  (dark: #444444)
    ================================================
    -->
    <!-- Global Attributes -->
    <mj-attributes>
      <!-- Entire Email -->
      <mj-all
        font-family="'Lato', Georgia, 'Times New Roman', Arial, serif"
        color="#444444"
        line-height="1.5"
      />

      <!-- Body -->
      <mj-body background-color="#f4f4f4" />

      <!-- Sections -->
      <mj-section padding="0" background-color="#ffffff" />

      <!-- Columns -->
      <mj-column padding="0" />

      <!-- Text -->
      <mj-text
        padding="0"
        font-size="16px"
        line-height="24px"
        color="#444444"
      />

      <!-- Buttons — primary default -->
      <mj-button
        border-radius="4px"
        font-size="14px"
        font-weight="600"
        inner-padding="14px 28px"
        padding="0"
        background-color="#111111"
        color="#ffffff"
      />

      <!-- Images -->
      <mj-image padding="0" border="0" fluid-on-mobile="true" />

      <!-- Divider -->
      <mj-divider
        border-style="solid"
        border-color="#e8e8e8"
        border-width="1px"
        width="100%"
        align="left"
        padding="15px 0"
      />
    </mj-attributes>

    <!-- STYLE BLOCK 1: Inlined regular styles -->
    <mj-style inline="inline">
      a {
        text-decoration: none;
      }
      img {
        display: block;
        border: 0;
        outline: none;
        text-decoration: none;
      }
      p {
        margin: 0;
        padding: 0;
      }
    </mj-style>

    <!-- Raw meta tags -->
    <mj-raw>
      <meta charset="UTF-8" /> <meta http-equiv="X-UA-Compatible"
      content="IE=edge" /> <meta name="viewport" content="width=device-width,
      initial-scale=1.0" /> <meta name="format-detection" content="telephone=no,
      date=no, address=no, email=no, url=no" /> <meta
      name="x-apple-disable-message-reformatting" /> <meta
      http-equiv="List-Unsubscribe"
      content="<mailto:unsubscribe@example.com?subject=unsubscribe>,
      <https://example.com/unsubscribe>" />
    </mj-raw>
  </mj-head>

  <mj-body width="600px" background-color="#f4f4f4">
    <mj-section padding="10px 15px" background-color="#f3ede7">
      <mj-group>
        <mj-column width="5%" vertical-align="middle">
          <mj-image
            fluid-on-mobile="false"
            src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1780070061/email-portfolio/belora-ecommerce-email/icons/truck_kwit9k.png"
            alt="shipping truck"
            width="24px"
          />
        </mj-column>
        <mj-column width="65%" vertical-align="middle">
          <mj-text font-size="12px" padding="0px 0px 0px 5px" line-height="1.1">
            Free shipping on orders over $75
          </mj-text>
        </mj-column>

        <mj-column width="30%" vertical-align="middle">
          <mj-text align="right" line-height="1.1">
            <a
              href="#"
              target="_blank"
              style="
                color: #111111;
                text-decoration: underline;
                font-size: 12px;
              "
              >View in browser</a
            >
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <!-- ============================================================ -->
    <!-- LOGO                                                          -->
    <!-- ============================================================ -->
    <mj-section background-color="#ffffff">
      <mj-column vertical-align="top">
        <mj-image
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1780070063/email-portfolio/belora-ecommerce-email/images/logo_nw0d0r.png"
          alt="Ultimate Technology Limited"
          href="https://taqwaitagency.com"
          padding="16px 0"
          width="150px"
        />
      </mj-column>
    </mj-section>

    <!-- ============================================================ -->
    <!-- NAVBAR                                                        -->
    <!-- ============================================================ -->
    <mj-section background-color="#ffffff">
      <mj-column>
        <mj-text
          css-class="dm-text-nav"
          align="center"
          font-size="12px"
          color="#444444"
          line-height="1.8"
          font-weight="600"
        >
          <a
            target="_blank"
            href="https://mjml.io/getting-started?utm_source=email&utm_medium=newsletter&utm_campaign=summer_sale"
            style="
              color: #444444;
              text-decoration: none;
              text-transform: uppercase;
              font-size: 12px;
              padding: 5px 10px;
            "
            >New in</a
          >
          <a
            href="https://mjml.io/try-it-live?utm_source=email&utm_medium=newsletter&utm_campaign=summer_sale"
            target="_blank"
            style="
              color: #444444;
              text-decoration: none;
              text-transform: uppercase;
              font-size: 12px;
              padding: 5px 10px;
            "
            >Women</a
          >
          <a
            href="https://mjml.io/templates?utm_source=email&utm_medium=newsletter&utm_campaign=summer_sale"
            target="_blank"
            style="
              color: #444444;
              text-decoration: none;
              text-transform: uppercase;
              font-size: 12px;
              padding: 5px 10px;
            "
            >Men</a
          >
          <a
            href="https://mjml.io/components?utm_source=email&utm_medium=newsletter&utm_campaign=summer_sale"
            target="_blank"
            style="
              color: #444444;
              text-decoration: none;
              text-transform: uppercase;
              font-size: 12px;
              padding: 5px 10px;
            "
            >Accessories</a
          >
          <a
            href="https://mjml.io/components?utm_source=email&utm_medium=newsletter&utm_campaign=summer_sale"
            target="_blank"
            style="
              color: #444444;
              text-decoration: none;
              text-transform: uppercase;
              font-size: 12px;
              padding: 5px 10px;
            "
            >Sale</a
          >
        </mj-text>
      </mj-column>
    </mj-section>

    <!--
    mj spacer
    For creating horizontal space between sections
    -->
    <mj-section css-class="dm-bg-section">
      <mj-column>
        <mj-spacer height="15px" />
      </mj-column>
    </mj-section>

    <!-- ============================================================ -->
    <!-- HERO — dark bg image, no dark mode override needed            -->
    <!-- ============================================================ -->
    <mj-section padding="0px" background-color="#f5ede4">
      <mj-column vertical-align="middle" padding="30px 15px">
        <mj-text
          text-transform="uppercase"
          font-size="14px"
          font-weight="600"
          line-height="1.1"
        >
          Summer collection `24
        </mj-text>
        <mj-text
          color="#111111"
          font-family="Playfair"
          align="left"
          line-height="1"
          padding="5px 0px 20px 0px"
          text-transform="capitalize"
          font-size="48px"
          font-weight="700"
        >
          <span style="color: #111111"> Elevate your </span><br />
          <span style="font-style: italic; color: #d6552e">Everyday</span>
        </mj-text>

        <mj-text
          font-size="14px"
          line-height="1.4"
          font-weight="500"
          color="#111111"
          padding="0px 0px 30px"
        >
          <span>Discover breathable fabrics, modern</span><br />
          <span>silhouettes and color that feel like</span><br />
          <span>sunshines.</span>
        </mj-text>
        <!-- Hero button — amber accent -->
        <mj-button
          href="https://mjml.io/product"
          font-size="12px"
          font-weight="600"
          letter-spacing="0.12em"
          color="#ffffff"
          background-color="#1a1a1a"
          border-radius="0"
          inner-padding="16px 36px"
          align="left"
          padding-bottom="0px"
        >
          SHOP THE <br />
          COLLECTION &nbsp;→
        </mj-button>
      </mj-column>
      <mj-column vertical-align="middle" padding="0px">
        <mj-image
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1780110726/email-portfolio/belora-ecommerce-email/images/banner-3_bc46x0.jpg"
          alt="banner image"
          align="left"
          padding="0px 0px 0px 15px"
        />
      </mj-column>
    </mj-section>

    <!-- MJ Border -->
        <mj-section>
          <mj-column>
            <mj-divider
              border-style="solid"
              border-color="#888888"
              border-width="2px"
              width="100%"
              align="left"
              padding="0px"
            />
          </mj-column>
        </mj-section>
  </mj-body>
</mjml>
